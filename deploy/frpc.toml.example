# frp 客户端配置（放在内网服务器，与 frps 版本一致，frp >= 0.52 用 TOML）
# 下载：https://github.com/fatedier/frp/releases
# 服务端 frps.toml 见同目录 frps.toml.example

serverAddr = "x.x.x.x"        # frps 所在公网服务器 IP
serverPort = 7000
auth.method = "token"
auth.token = "CHANGE_ME_STRONG_TOKEN"

[[proxies]]
name = "black-erp-web"
type = "tcp"
localIP = "127.0.0.1"
localPort = 80               # nginx 映射的 80 端口
remotePort = 18080           # 公网访问 http://x.x.x.x:18080

# 可选：直接暴露后端（调试用，生产不建议）
# [[proxies]]
# name = "black-erp-api"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 8000
# remotePort = 18000
